{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inmo",
  "version": "1.1.0",
  "identifier": "com.inmo",
  "build": {
    "frontendDist": "../tauri-ui-dist",
    "beforeDevCommand": "node build-ui.js",
    "beforeBuildCommand": "node build-ui.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "INMO",
        "url": "src/index.html",
        "width": 1300,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
