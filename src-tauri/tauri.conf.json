{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inmo",
  "version": "1.2.0",
  "identifier": "com.inmo",
  "build": {
    "frontendDist": "../tauri-ui-dist",
    "beforeDevCommand": "node build-ui.js",
    "beforeBuildCommand": "node build-ui.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "INMO",
        "url": "src/index.html",
        "width": 1300,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#0a0a0c"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "script-src",
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMTk5NkQ2NUVEQzI2OTMKUldTVEp0eGUxcFlaUDlBSVlralowMEFUS2RVeVBtVllGSXBkMUYyaEpmSHpZSFpDbThaK1YyVHAK",
      "endpoints": [
        "https://github.com/rrr090/inmo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
